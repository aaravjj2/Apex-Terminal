# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Apex Terminal — Environment Variables Reference                              │
# │                                                                              │
# │ Copy this file to keys.env (gitignored) and fill in real values.            │
# │ Production: set these as server/container environment variables instead.    │
# └─────────────────────────────────────────────────────────────────────────────┘

# ── Runtime Profile ────────────────────────────────────────────────────────────
# "dev" loads keys.env file. "prod" reads env vars only (for Heroku/Docker).
PROFILE=dev

# ── Backend Server ─────────────────────────────────────────────────────────────
# Port: backend runs on 8000. Frontend dev server runs on 5100, proxies /api → 8000.
API_HOST=0.0.0.0
API_PORT=8000

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Dev: localhost:5100 | Prod: add your deployed frontend URL.
ALLOWED_ORIGINS=http://localhost:5100,http://localhost:5173,http://localhost:3000

# ── Alpaca (REQUIRED for live trading + market data) ─────────────────────────
# Get keys at: https://alpaca.markets → Paper Trading dashboard
APCA_API_KEY_ID=PK_YOUR_ALPACA_KEY_HERE        # REQUIRED — enables broker + market data
APCA_API_SECRET_KEY=YOUR_ALPACA_SECRET_HERE    # REQUIRED — authentication
APCA_ENDPOINT=https://paper-api.alpaca.markets  # Use paper-api for testing, api.alpaca.markets for live

# ── Finnhub (RECOMMENDED for real-time news + sentiment) ──────────────────────
# Free tier available at: https://finnhub.io/register
FINNHUB_API_KEY=YOUR_FINNHUB_KEY_HERE           # Optional — enables news + WebSocket streaming
FINNHUB2_API_KEY=                               # Optional — second Finnhub key for rate limit bypass

# ── Tradier (RECOMMENDED for options data) ────────────────────────────────────
# Get at: https://developer.tradier.com/
TRADIER_BROKERAGE_KEY=YOUR_TRADIER_KEY_HERE     # Optional — options chain, Greeks
TRADIER_SANDBOX_KEY=                            # Optional — Tradier sandbox

# ── Polygon (OPTIONAL — additional market data source) ───────────────────────
POLYGON_API_KEY=                                # Optional — equities, options, forex

# ── Tiingo (OPTIONAL — yfinance alternative) ─────────────────────────────────
TIINGO_API_KEY=                                 # Optional — delayed quotes fallback

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite is used by default for local dev. Set this for Postgres in production.
DATABASE_URL=postgresql+asyncpg://dashboard_user:newpassword@localhost:5432/financial_dashboard

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                                  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text                                 # text (dev) | json (prod)

# ── Market Data ────────────────────────────────────────────────────────────────
# Symbols tracked for bar ingestion and autopilot scanning.
MARKET_UNIVERSE=AAPL,MSFT,GOOGL,AMZN,NVDA,TSLA,META,SPY,QQQ,IWM
MARKET_HISTORY_YEARS=7

# ── Autopilot ──────────────────────────────────────────────────────────────────
# Options trading config. See phase1/autopilot_config.json for full config.
INGESTION_MODE=live                             # live | mock

# ── Elasticsearch (OPTIONAL — required only for advanced search) ──────────────
# Set elastic_required=True (or ELASTIC_REQUIRED=true env) only if ES is running.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=                          # Optional — ES API key
ELASTIC_REQUIRED=false                          # false = ES optional (graceful degradation)

# ── ElevenLabs TTS (OPTIONAL) ─────────────────────────────────────────────────
ELEVENLABS_API_KEY=                             # Optional — voice narration
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM       # Default "Rachel" voice
