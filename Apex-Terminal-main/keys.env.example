# keys.env.example - Template for local secret keys
# Copy this file to `keys.env` and fill in your real values (do NOT commit keys.env)

# Market data
FINNHUB_API_KEY=your_finnhub_api_key_here
FINNHUB2_API_KEY=your_finnhub_api_key_here
POLYGON_API_KEY=your_polygon_api_key_here
TIINGO_API_KEY=your_tiingo_api_key_here

# LLM providers
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
LLM_MODE=hybrid

# Broker / Trading keys
aPAC_API_KEY_ID=your_alpaca_api_key_id_here
APCA_API_SECRET_KEY=your_alpaca_api_secret_here
TRADIER_BROKERAGE_KEY=your_tradier_key_here

# Database
POSTGRES_USER=dashboard_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=financial_dashboard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Notes: keep the real keys out of the repository and use environment variables in CI/production
