{
  "name": "devpost-media-scripts",
  "version": "1.0.0",
  "description": "Automation scripts for Devpost media capture",
  "private": true,
  "scripts": {
    "capture:screenshots": "ts-node scripts/capture_screenshots.ts",
    "record:video": "ts-node scripts/record_video.ts",
    "generate:diagram": "python3 scripts/generate_architecture_diagram.py",
    "build": "tsc",
    "all": "npm run generate:diagram && npm run capture:screenshots && npm run record:video"
  },
  "dependencies": {
    "@playwright/test": "^1.41.0",
    "playwright": "^1.41.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  }
}
