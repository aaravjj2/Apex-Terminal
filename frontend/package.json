{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "vitest run tests/unit",
    "test:int": "vitest run tests/integration --passWithNoTests",
    "test:e2e": "npm run selector-gate && npm run build && PLAYWRIGHT_CHROMIUM_DISABLE_SANDBOX=1 playwright test",
    "test:3loop": "tsx scripts/run_3loop_frontend.ts",
    "ag:run": "node scripts/run_ag.cjs",
    "selector-gate": "node ../scripts/selector-policy-gate.js tests/e2e/",
    "verify:tsc": "tsc --noEmit",
    "verify:unit": "vitest run",
    "verify:e2e": "npm run selector-gate && npx playwright test",
    "test:e2e:mcp": "npx playwright test --config=playwright.config.mcp.ts",
    "test:e2e:mcp:twice": "npx playwright test --config=playwright.config.mcp.ts && npx playwright test --config=playwright.config.mcp.ts",
    "verify:all": "npm run verify:tsc && npm run verify:unit && npm run verify:e2e"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "immer": "^11.1.3",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.3.2",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^5.2.0",
    "vitest": "^4.0.16"
  }
}
