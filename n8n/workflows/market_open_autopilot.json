{
    "name": "Market Open Autopilot",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "cronExpression",
                            "expression": "30 9 * * 1-5"
                        }
                    ]
                }
            },
            "id": "cron-trigger",
            "name": "Market Open Trigger",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.1,
            "position": [
                0,
                0
            ],
            "notes": "Triggers at 09:30 AM America/New_York on weekdays (Mon-Fri)"
        },
        {
            "parameters": {
                "method": "POST",
                "url": "http://host.docker.internal:8000/api/v1/autopilot/run",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "dry_run",
                            "value": "false"
                        },
                        {
                            "name": "force",
                            "value": "false"
                        }
                    ]
                },
                "options": {
                    "timeout": 60000
                }
            },
            "id": "run-autopilot",
            "name": "Run Autopilot",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                220,
                0
            ]
        },
        {
            "parameters": {
                "amount": 30,
                "unit": "seconds"
            },
            "id": "wait-30s",
            "name": "Wait 30s",
            "type": "n8n-nodes-base.wait",
            "typeVersion": 1.1,
            "position": [
                440,
                0
            ]
        },
        {
            "parameters": {
                "method": "GET",
                "url": "http://host.docker.internal:8000/api/v1/verification/last_run",
                "options": {
                    "timeout": 30000
                }
            },
            "id": "verify-last-run",
            "name": "Verify Last Run",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                660,
                0
            ]
        },
        {
            "parameters": {
                "method": "GET",
                "url": "http://host.docker.internal:8000/api/v1/verification/alpaca/recent_activity",
                "options": {
                    "timeout": 30000
                }
            },
            "id": "check-alpaca-activity",
            "name": "Check Alpaca Activity",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                880,
                0
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": "",
                        "typeValidation": "strict"
                    },
                    "conditions": [
                        {
                            "id": "check-executions",
                            "leftValue": "={{ $json.orders?.length || 0 }}",
                            "rightValue": 0,
                            "operator": {
                                "type": "number",
                                "operation": "equals"
                            }
                        }
                    ],
                    "combinator": "and"
                },
                "options": {}
            },
            "id": "check-executions",
            "name": "Check Executions",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                1100,
                0
            ]
        },
        {
            "parameters": {
                "method": "GET",
                "url": "http://host.docker.internal:8000/api/v1/reports/daily",
                "options": {
                    "timeout": 30000
                }
            },
            "id": "get-daily-report",
            "name": "Get Daily Report",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                1320,
                100
            ]
        },
        {
            "parameters": {
                "message": "=## Autopilot Run Complete\n\n**Run ID:** {{ $('Run Autopilot').item.json.run_id }}\n\n### Verification Results\n- **Verified:** {{ $('Verify Last Run').item.json.verified_count || 0 }}\n- **Discrepancies:** {{ $('Verify Last Run').item.json.discrepancy_count || 0 }}\n\n### Alpaca Activity\n- **Orders Found:** {{ $('Check Alpaca Activity').item.json.orders?.length || 0 }}\n\n✅ All systems operational",
                "options": {}
            },
            "id": "log-success",
            "name": "Log Success",
            "type": "n8n-nodes-base.noOp",
            "typeVersion": 1,
            "position": [
                1320,
                -100
            ],
            "notes": "Placeholder for Slack/email notification"
        },
        {
            "parameters": {
                "message": "=## ⚠️ No Executions Detected\n\n**Run ID:** {{ $('Run Autopilot').item.json.run_id }}\n\nNo orders were detected in Alpaca. This may indicate:\n- Market conditions didn't meet criteria\n- Risk limits prevented trades\n- System issue\n\nPlease review the verification logs.",
                "options": {}
            },
            "id": "log-no-executions",
            "name": "Log No Executions",
            "type": "n8n-nodes-base.noOp",
            "typeVersion": 1,
            "position": [
                1320,
                200
            ],
            "notes": "Alert: No executions detected"
        }
    ],
    "connections": {
        "Market Open Trigger": {
            "main": [
                [
                    {
                        "node": "Run Autopilot",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Run Autopilot": {
            "main": [
                [
                    {
                        "node": "Wait 30s",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Wait 30s": {
            "main": [
                [
                    {
                        "node": "Verify Last Run",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Verify Last Run": {
            "main": [
                [
                    {
                        "node": "Check Alpaca Activity",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Check Alpaca Activity": {
            "main": [
                [
                    {
                        "node": "Check Executions",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Check Executions": {
            "main": [
                [
                    {
                        "node": "Log Success",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Log No Executions",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Log Success": {
            "main": [
                [
                    {
                        "node": "Get Daily Report",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Log No Executions": {
            "main": [
                [
                    {
                        "node": "Get Daily Report",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "active": false,
    "settings": {
        "timezone": "America/New_York",
        "executionTimeout": 300
    },
    "staticData": null,
    "meta": {
        "templateId": "market-open-autopilot"
    }
}