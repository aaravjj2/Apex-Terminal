{
  "name": "Market Open Autopilot",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 9 * * 1-5"
            }
          ]
        }
      },
      "id": "trigger-market-open",
      "name": "Market Open Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "notes": "Triggers at 9:30 AM ET, Mon-Fri (Market Open)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AUTOPILOT_API_URL || 'http://host.docker.internal:8000' }}/api/v1/autopilot/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "dry_run",
              "value": "false"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "run-autopilot",
      "name": "Run Autopilot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-status",
              "leftValue": "={{ $json.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-result",
      "name": "Check Run Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "wait-time",
              "name": "wait_seconds",
              "value": 30,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "set-wait-time",
      "name": "Set Wait Time",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [900, 240]
    },
    {
      "parameters": {
        "amount": "={{ $json.wait_seconds }}",
        "unit": "seconds"
      },
      "id": "wait-for-fills",
      "name": "Wait for Fills",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1120, 240]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.AUTOPILOT_API_URL || 'http://host.docker.internal:8000' }}/api/v1/verification/last_run",
        "options": {
          "timeout": 60000
        }
      },
      "id": "verify-trades",
      "name": "Verify Trades",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1340, 240]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.AUTOPILOT_API_URL || 'http://host.docker.internal:8000' }}/api/v1/autopilot/last_run_summary",
        "options": {}
      },
      "id": "get-summary",
      "name": "Get Run Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1560, 240]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "report",
              "name": "report",
              "value": "=## Autopilot Run Report\n\n**Run ID:** {{ $('Run Autopilot').item.json.run_id }}\n**Status:** {{ $('Run Autopilot').item.json.status }}\n\n### Trade Counts\n- Candidates: {{ $('Run Autopilot').item.json.candidates_count }}\n- Selected: {{ $('Run Autopilot').item.json.selected_count }}\n- Executed: {{ $('Run Autopilot').item.json.executed_count }}\n\n### Verification\n- Verified: {{ $('Verify Trades').item.json.verified_count }}\n- Discrepancies: {{ $('Verify Trades').item.json.discrepancy_count }}\n- Summary: {{ $('Verify Trades').item.json.summary }}\n\n### Details\n{{ $json }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "build-report",
      "name": "Build Report",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [1780, 240]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "error-message",
              "name": "error_message",
              "value": "=Autopilot run failed: {{ $json.message || $json.detail || 'Unknown error' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "handle-error",
      "name": "Handle Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [900, 400]
    },
    {
      "parameters": {},
      "id": "end-success",
      "name": "Success",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [2000, 240]
    },
    {
      "parameters": {},
      "id": "end-failure",
      "name": "Failure",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1120, 400]
    }
  ],
  "connections": {
    "Market Open Trigger": {
      "main": [
        [
          {
            "node": "Run Autopilot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Autopilot": {
      "main": [
        [
          {
            "node": "Check Run Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Run Status": {
      "main": [
        [
          {
            "node": "Set Wait Time",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Handle Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Wait Time": {
      "main": [
        [
          {
            "node": "Wait for Fills",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for Fills": {
      "main": [
        [
          {
            "node": "Verify Trades",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Trades": {
      "main": [
        [
          {
            "node": "Get Run Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Run Summary": {
      "main": [
        [
          {
            "node": "Build Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Report": {
      "main": [
        [
          {
            "node": "Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Handle Error": {
      "main": [
        [
          {
            "node": "Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1",
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "tradingview-autopilot"
  },
  "tags": [
    {
      "name": "autopilot",
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z"
    }
  ]
}
